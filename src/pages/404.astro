---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Dimas Aji Samudra" description="This page does not exist.">
  <section class="page">
    <div class="container not-found">
      <h1 class="page-title">Page not found</h1>
      <p class="lead">The link may be old or mistyped. The projects are all on the Works page.</p>
      <div><a class="btn" href="/works/">Go to Works</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { display: flex; flex-direction: column; gap: 20px; min-height: 40vh; }
</style>
