---
import type { ImageMetadata } from "astro";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import Row from "../../components/Row.astro";
import ZoomImage from "../../components/ZoomImage.astro";
import VideoReel from "../../components/VideoReel.astro";
import canvas from "../../assets/images/projects/lead-follow-up-automation/n8n-canvas.png";

// Studi kasus untuk menjual jasa otomasi. Dipasang dari template publik n8n (#6941): fakta "Based on"
// dan kalimat di My Role tetap menyebut community workflow. Tanpa angka hasil (belum ada data nyata).
// Screenshot dari n8n Dimas, dipotong lewat source-files/scripts/prepare-lead-screens.py

// Video demo 30–60 detik. Selama `null`, tampil tempat kosong "coming soon".
// Cara mengisi: taruh demo.mp4 + demo-poster.jpg di src/assets/video|images/projects/lead-follow-up-automation/,
// import keduanya, lalu isi: { src: demoVideo, poster: demoPoster }
type Demo = { src: string; poster: ImageMetadata };
const demo = null as Demo | null;

// Alur untuk orang non-teknis (sesuai node di workflow n8n-nya)
const steps = [
  { title: "Lead submits a form", text: "Name, company and their question arrive through a simple web form." },
  { title: "Lead is saved", text: "Every entry is added to a Google Sheet, so nothing gets lost." },
  { title: "AI analyzes the lead", text: "It looks up the company and answers simple questions by email. Anything unclear goes to a person." },
  { title: "Lead is qualified", text: "AI compares the lead with your ideal-customer rules and picks one of three paths." },
];
const paths = [
  { name: "Demo ready", to: "Meeting booked in Google Calendar" },
  { name: "Nurture", to: "Follow-up emails a day apart, then a demo invite" },
  { name: "Drop", to: "A polite reply, no further follow-up" },
];
const before = [
  "Leads need to be checked by hand",
  "Qualifying each lead takes time",
  "Follow-ups can be forgotten",
  "Booking meetings means back-and-forth emails",
];
const after = [
  "Leads are captured automatically",
  "AI helps sort incoming leads",
  "Follow-ups go out on time",
  "Qualified leads are guided to a meeting",
];
const value = [
  "Respond faster to incoming leads",
  "Spend less time on repetitive lead management",
  "Keep follow-ups organized",
  "Focus on the leads that need a person",
  "Cut manual admin work",
];
---

<ProjectLayout
  name="Lead Follow-up Automation"
  subtitle="Automated lead qualification, follow-up and meeting scheduling with AI."
  pitch="Turn incoming leads into organized, qualified opportunities without manually chasing every reply."
  description="Automated lead qualification, follow-up and meeting scheduling with AI, built in n8n with Google Workspace."
  year={2026}
  tags={["Automation", "AI", "Google Workspace"]}
  facts={[
    { label: "Role", value: "Setup, adaptation, integration" },
    { label: "Tools", value: "n8n, OpenAI, Google Workspace" },
    { label: "Based on", value: "n8n community workflow" },
    { label: "Status", value: "Demo · Ready for business customization" },
  ]}
  cta={{
    title: "Have a repetitive process that should run automatically?",
    text: "Tell me how your current process works. I'll help identify what can be automated.",
  }}
  next={{ href: "/projects/content-workflow-automation/", name: "Content Workflow Automation" }}
>
  <div slot="hero" class="container--wide project__hero">
    <div class="screen">
      <div class="screen__bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="screen__scroll">
        <ZoomImage
          image={canvas}
          alt="The lead follow-up workflow in n8n: input form, Google Sheets, AI answer agent, AI lead enrichment, AI lead classifier and three paths for demo-ready, nurture and drop leads with Gmail and Google Calendar"
          caption="The workflow in n8n"
          widths={[720, 1100, 1572]}
          sizes="(max-width: 767px) 760px, (max-width: 1160px) calc(100vw - 40px), 1120px"
          loading="eager"
        />
      </div>
    </div>
    <p class="screen__hint">Swipe to see the whole workflow, or tap to enlarge.</p>
  </div>

  <Row label="Overview">
    <p class="lead">Leads can go cold when replies are delayed, qualification is manual, or follow-ups are forgotten. This automation handles the repetitive parts of the lead journey, so a business can focus on the conversations that need a person.</p>
  </Row>

  <Row label="How it works">
    <ol class="flow">
      {steps.map((s, i) => (
        <li class="flow__step">
          <span class="flow__num" aria-hidden="true">{i + 1}</span>
          <div>
            <p class="flow__title">{s.title}</p>
            <p class="flow__text">{s.text}</p>
          </div>
        </li>
      ))}
      <li class="flow__step flow__step--paths">
        <span class="flow__num" aria-hidden="true">{steps.length + 1}</span>
        <div>
          <p class="flow__title">One of three paths</p>
          <ul class="paths">
            {paths.map((p) => (
              <li class="path">
                <span class="path__name">{p.name}</span>
                <span class="path__arrow" aria-hidden="true">→</span>
                <span class="path__to">{p.to}</span>
              </li>
            ))}
          </ul>
        </div>
      </li>
      <li class="flow__step">
        <span class="flow__num" aria-hidden="true">{steps.length + 2}</span>
        <div>
          <p class="flow__title">Status is updated automatically</p>
          <p class="flow__text">The sheet always shows where each lead stands.</p>
        </div>
      </li>
    </ol>
  </Row>

  <Row label="Demo">
    <div class="demo-head">
      <h3 class="demo-head__title">See the automation in action</h3>
      <p>A short walkthrough showing how a new lead moves through the automated process.</p>
    </div>
    {demo ? (
      <VideoReel
        orientation="landscape"
        label="Lead follow-up automation demo"
        videos={[{ src: demo.src, poster: demo.poster, title: "Demo walkthrough" }]}
      />
    ) : (
      <div class="demo-soon">
        <span class="demo-soon__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" /></svg>
        </span>
        <p class="demo-soon__title">Demo video coming soon</p>
        <p class="demo-soon__text">Want to see it sooner? I can walk you through it on a short call.</p>
      </div>
    )}
  </Row>

  <Row label="Before / After">
    <div class="compare">
      <div class="compare__col">
        <p class="compare__label">Before</p>
        <ul>{before.map((b) => <li>{b}</li>)}</ul>
      </div>
      <div class="compare__col compare__col--after">
        <p class="compare__label">After</p>
        <ul>{after.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>
  </Row>

  <Row label="Business value">
    <h3 class="value__title">What this automation helps businesses do</h3>
    <ul class="value">
      {value.map((v) => (
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          {v}
        </li>
      ))}
    </ul>
  </Row>

  <Row label="Technology">
    <div class="chips"><span class="chip">n8n</span><span class="chip">OpenAI</span><span class="chip">Gmail</span><span class="chip">Google Calendar</span><span class="chip">Google Sheets</span></div>
  </Row>

  <Row label="My Role">
    <p>My role is to set up, adapt and customize the automation for a specific business process, including the lead qualification rules, AI behavior, email flow, follow-up logic and Google Workspace integrations.</p>
    <p class="muted-note">Built from an n8n community workflow and adapted for business-specific requirements.</p>
  </Row>
</ProjectLayout>

<style>
  /* ---------- Screenshot workflow ---------- */
  .screen {
    overflow: hidden;
    border: 1px solid var(--c-frame-line);
    border-radius: 10px;
    background: #1b1b1b;
    box-shadow: var(--shadow-frame);
  }
  .screen__bar {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    background: var(--c-chrome);
    border-bottom: 1px solid var(--c-chrome-line);
  }
  .screen__bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--c-chrome-dot); }
  .screen :global(.zoom) { display: block; width: 100%; }
  .screen :global(img) { display: block; width: 100%; height: auto; }
  .screen__hint { display: none; }

  /* HP: screenshot tetap terbaca — lebar tetap 760px dan bisa digeser di dalam bingkai (halaman tidak) */
  @media (max-width: 767px) {
    .screen__scroll { overflow-x: auto; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
    .screen__scroll :global(.zoom) { width: 760px; }
    .screen__hint { display: block; margin-top: 10px; font-size: 13px; line-height: 18px; color: var(--c-muted); }
  }

  /* ---------- Alur ---------- */
  .flow { list-style: none; display: flex; flex-direction: column; }
  .flow__step { position: relative; display: grid; grid-template-columns: 30px 1fr; gap: 14px; padding-bottom: 20px; }
  .flow__step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 32px;
    bottom: 4px;
    width: 2px;
    background: var(--c-line);
  }
  .flow__num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--c-badge);
    color: var(--c-white);
    font-size: 14px;
    font-weight: 700;
  }
  .flow__title { font-size: 17px; line-height: 30px; font-weight: 700; }
  .flow__text { font-size: 16px; line-height: 24px; color: var(--c-muted); }

  .paths { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  .path {
    display: grid;
    grid-template-columns: 112px 20px 1fr;
    align-items: baseline;
    padding: 12px 14px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-surface);
    font-size: 16px;
    line-height: 24px;
  }
  .path__name { font-weight: 700; }
  .path__arrow { color: var(--c-muted); }

  /* ---------- Demo ---------- */
  .demo-head { display: flex; flex-direction: column; gap: 4px; }
  .demo-head__title, .value__title { font-size: 19px; line-height: 28px; font-weight: 700; }
  .demo-head p { color: var(--c-muted); }
  .demo-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    aspect-ratio: 16 / 9;
    padding: 24px;
    border: 1px dashed var(--c-muted);
    border-radius: var(--radius);
    background: var(--c-soft);
    text-align: center;
  }
  .demo-soon__play {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    color: var(--c-muted);
  }
  .demo-soon__play svg { fill: currentColor; margin-left: 3px; }
  .demo-soon__title { font-size: 18px; line-height: 26px; font-weight: 700; }
  .demo-soon__text { max-width: 26em; font-size: 15px; line-height: 22px; color: var(--c-muted); }

  /* ---------- Before / After ---------- */
  .compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .compare__col { padding: 20px; border: 1px solid var(--c-line); border-radius: var(--radius); background: var(--c-surface); }
  .compare__col--after { border-color: var(--c-link-bright); }
  .compare__label { margin-bottom: 10px; font-size: 13px; line-height: 18px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-muted); }
  .compare__col--after .compare__label { color: var(--c-link); }
  .compare ul { display: flex; flex-direction: column; gap: 8px; padding-left: 18px; font-size: 16px; line-height: 24px; }

  /* ---------- Manfaat ---------- */
  .value { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .value li { display: flex; gap: 12px; font-size: 17px; line-height: 26px; }
  .value svg { flex: none; margin-top: 3px; fill: none; stroke: var(--c-primary); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .muted-note { font-size: 15px; line-height: 22px; color: var(--c-muted); }

  @media (max-width: 767px) {
    .path { grid-template-columns: 1fr; gap: 2px; }
    .path__arrow { display: none; }
    .path__to { color: var(--c-muted); }
    .compare { grid-template-columns: 1fr; }
    .demo-soon { aspect-ratio: 4 / 3; }
  }
</style>
