---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, social, whatsappLink } from "../data/site";

const wa = whatsappLink();
---

<BaseLayout
  title="Contact — Dimas Aji Samudra"
  description="Interested in freelance, contract or full-time collaboration? Let's talk."
>
  <section class="page page--contact">
    <div class="container contact-page">
      <h1 class="page-title">Contact</h1>
      <p class="contact-intro">Interested in freelance, contract or full-time collaboration? Let's talk.</p>
      <div class="contact">
        <!-- FormSubmit (gratis, tanpa server): pesan dikirim ke email Dimas. Pesan pertama dari alamat situs baru
             memicu email aktivasi dari FormSubmit yang harus diklik sekali.
             Kalau pengiriman gagal, aplikasi email pengunjung dibuka dengan pesan yang sudah terisi. -->
        <form class="form" method="POST" action={`https://formsubmit.co/${site.email}`} data-email={site.email}>
          <input type="hidden" name="_subject" value="New message from your portfolio" />
          <input type="hidden" name="_template" value="table" />
          <p hidden><label>Leave this empty <input name="_honey" tabindex="-1" autocomplete="off" /></label></p>
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell me about the project or role" required></textarea>
          </div>
          <button class="btn" type="submit">Send Message</button>
          <p class="form__note" role="status"></p>
        </form>
        <div class="direct">
          <div class="direct__item">
            <p class="label-sm">Email</p>
            <a class="direct__value" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          {wa && (
            <div class="direct__item">
              <p class="label-sm">WhatsApp</p>
              <a class="direct__value" href={wa} target="_blank" rel="noopener">Chat on WhatsApp</a>
            </div>
          )}
          <div class="direct__item">
            <p class="label-sm">LinkedIn</p>
            <a class="direct__value" href={social.linkedin.href} target="_blank" rel="noopener">{social.linkedin.handle}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(".form");
  const note = form?.querySelector<HTMLElement>(".form__note");
  const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  // Cadangan: buka aplikasi email pengunjung dengan pesan yang sudah terisi
  const openEmailApp = (f: HTMLFormElement) => {
    const field = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value.trim();
    const name = field("name");
    const from = field("email");
    const subject = encodeURIComponent("Project inquiry" + (name ? " from " + name : ""));
    const body = encodeURIComponent(field("message") + "\n\n" + name + (from ? " <" + from + ">" : ""));
    window.location.href = `mailto:${f.dataset.email}?subject=${subject}&body=${body}`;
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!note || !button) return;
    button.disabled = true;
    button.textContent = "Sending…";
    note.textContent = "";
    note.classList.remove("is-sent");
    try {
      const data: Record<string, string> = {};
      new FormData(form).forEach((value, key) => (data[key] = String(value)));
      const res = await fetch(`https://formsubmit.co/ajax/${form.dataset.email}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(data),
      });
      // FormSubmit menjawab { success: "true" }; sebelum diaktifkan jawabannya success "false"
      const result = await res.json().catch(() => ({}));
      if (!res.ok || String(result.success) !== "true") throw new Error(result.message ?? String(res.status));
      form.reset();
      note.textContent = "Thanks! Your message is sent. I'll get back to you soon.";
      note.classList.add("is-sent");
    } catch {
      note.textContent = "Couldn't send it here, so your email app will open with the message ready.";
      openEmailApp(form);
    } finally {
      button.disabled = false;
      button.textContent = "Send Message";
    }
  });
</script>

<style>
  .page--contact { padding-bottom: 24px; }
  .contact-page { display: flex; flex-direction: column; gap: 16px; }
  .contact-intro { font-size: 22px; line-height: 32px; }
  .contact { display: flex; gap: 56px; padding-top: 16px; }

  .form { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .form__note { font-size: 14px; line-height: 20px; color: var(--c-muted); }
  .form__note:empty { margin-top: -16px; } /* tetap ada di DOM agar pesan status dibacakan pembaca layar */
  .form__note.is-sent { font-size: 16px; line-height: 24px; font-weight: 500; color: var(--c-text); }
  .form .btn:disabled { opacity: 0.7; cursor: progress; }
  .field { align-self: stretch; display: flex; flex-direction: column; gap: 8px; }
  .field label { font-size: 14px; line-height: 20px; font-weight: 500; }
  .field input,
  .field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--c-line);
    border-radius: 4px;
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    color: var(--c-text);
    background: var(--c-surface);
  }
  .field textarea { height: 150px; resize: vertical; }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--c-muted); opacity: 1; }
  .field input:focus-visible,
  .field textarea:focus-visible { outline: 2px solid var(--c-link); outline-offset: 0; border-color: var(--c-link); }

  .direct { flex: none; width: 280px; display: flex; flex-direction: column; gap: 20px; }
  .direct__item { display: flex; flex-direction: column; gap: 4px; }
  .direct__value { font-size: 18px; line-height: 26px; color: var(--c-link); overflow-wrap: anywhere; }
  .direct__value:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 767px) {
    .contact-intro { font-size: 18px; line-height: 28px; }
    .contact { flex-direction: column; gap: 36px; }
    .direct { width: auto; }
  }
</style>
