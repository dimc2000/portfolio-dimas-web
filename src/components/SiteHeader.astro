---
import { nav, site } from "../data/site";

const path = Astro.url.pathname;
// Halaman proyek & desain termasuk bagian "Works"; /websites/ dibuka dari kartu layanan
const isCurrent = (href: string) =>
  href === "/"
    ? path === "/"
    : path.startsWith(href) ||
      (href === "/works/" && (path.startsWith("/projects/") || path.startsWith("/design/"))) ||
      (href === "/services/" && path.startsWith("/websites/"));

// Menu bawah khusus HP (seperti Instagram): ikon + label kecil. Ikon garis 24x24.
const tabIcons: Record<string, string> = {
  "/works/": "M4 3.5h6a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-.5.5H4a.5.5 0 0 1-.5-.5V4a.5.5 0 0 1 .5-.5zM14 3.5h6a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1-.5-.5V4a.5.5 0 0 1 .5-.5zM4 13.5h6a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-.5.5H4a.5.5 0 0 1-.5-.5v-6a.5.5 0 0 1 .5-.5zM14 13.5h6a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1-.5-.5v-6a.5.5 0 0 1 .5-.5z",
  "/services/": "M5 7h14a1.5 1.5 0 0 1 1.5 1.5v10A1.5 1.5 0 0 1 19 20H5a1.5 1.5 0 0 1-1.5-1.5v-10A1.5 1.5 0 0 1 5 7zM9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3.5 12.5h17",
  "/contact/": "M20.5 11.5a8 8 0 0 1-11.9 7L3.5 20l1.5-4.6a8 8 0 1 1 15.5-3.9z",
};
const tabs = [
  { label: "Home", href: "/", icon: "M3.5 10.5 12 3.5l8.5 7V20a1 1 0 0 1-1 1H15v-6.5H9V21H4.5a1 1 0 0 1-1-1z" },
  ...nav.map((item) => ({ ...item, icon: tabIcons[item.href] })),
];
---

<header class="nav">
  <a class="nav__logo" href="/">{site.name}</a>
  <div class="nav__right">
    <nav class="nav__links" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M20.5 13.4A8.5 8.5 0 1 1 10.6 3.5a6.6 6.6 0 0 0 9.9 9.9z" />
      </svg>
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </svg>
    </button>
  </div>
</header>

<nav class="tabbar" aria-label="Main">
  {tabs.map((tab) => (
    <a href={tab.href} aria-current={isCurrent(tab.href) ? "page" : undefined}>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={tab.icon} /></svg>
      <span>{tab.label}</span>
    </a>
  ))}
</nav>

<script>
  // ---------- Tema gelap / terang ----------
  type Theme = "light" | "dark";
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  const applyTheme = (theme: Theme) => {
    root.dataset.theme = theme;
    themeMeta?.setAttribute("content", theme === "dark" ? "#000000" : "#ffffff");
    const label = `Switch to ${theme === "dark" ? "light" : "dark"} theme`;
    themeButton?.setAttribute("aria-label", label);
    themeButton?.setAttribute("title", label);
  };
  const savedTheme = (): Theme | null => {
    try {
      const value = localStorage.getItem("theme");
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  applyTheme(root.dataset.theme === "dark" ? "dark" : "light");
  themeButton?.addEventListener("click", () => {
    const next: Theme = root.dataset.theme === "dark" ? "light" : "dark";
    applyTheme(next);
    try { localStorage.setItem("theme", next); } catch {}
  });
  // Belum memilih sendiri → ikuti perubahan pengaturan perangkat
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    if (!savedTheme()) applyTheme(e.matches ? "dark" : "light");
  });
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 27px 60px;
  }
  .nav__logo { font-size: 20px; line-height: 30px; font-weight: 500; }
  .nav__right { display: flex; align-items: center; gap: 28px; }
  .nav__links { display: flex; gap: 32px; }
  .nav__links a { font-size: 20px; line-height: 30px; font-weight: 500; }
  .nav__links a:hover,
  .nav__links a[aria-current="page"] { color: var(--c-primary-ink); }

  /* ---------- Tombol tema: bulan di mode terang, matahari di mode gelap ---------- */
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: transparent;
    color: var(--c-text);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .theme-toggle:hover { background: var(--c-soft); border-color: var(--c-muted); }
  .theme-toggle svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle__sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle__sun { display: block; }
  :global(:root[data-theme="dark"]) .theme-toggle__moon { display: none; }

  /* ---------- Menu bawah (HP saja) ---------- */
  .tabbar { display: none; }

  @media (max-width: 767px) {
    .nav { padding: 16px 20px; }
    .nav__logo { font-size: 18px; line-height: 27px; }
    .theme-toggle { width: 36px; height: 36px; }
    .nav__links { display: none; }

    .tabbar {
      position: fixed;
      z-index: 50;
      left: 0;
      right: 0;
      bottom: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding: 6px max(8px, env(safe-area-inset-right)) calc(6px + env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left));
      background: var(--c-surface);
      border-top: 1px solid var(--c-line);
    }
    .tabbar a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 4px 0;
      font-size: 11px;
      line-height: 14px;
      font-weight: 500;
      color: var(--c-muted);
      -webkit-tap-highlight-color: transparent;
    }
    .tabbar svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    /* Halaman aktif: ikon terisi + warna utama (seperti Instagram) */
    .tabbar a[aria-current="page"] { color: var(--c-text); font-weight: 700; }
    .tabbar a[aria-current="page"] svg { fill: color-mix(in srgb, var(--c-primary) 25%, transparent); stroke: var(--c-primary-ink); stroke-width: 2; }
  }
</style>
