---
/*
  Satu bagian galeri di halaman studi kasus desain: judul, penjelasan singkat, lalu isi (slot).
  `cols` mengatur jumlah kolom grid untuk isi; 0 = isi mengatur tata letaknya sendiri.
*/
interface Props {
  title: string;
  text?: string;
  cols?: 0 | 2 | 3 | 4;
  id?: string;
}
const { title, text, cols = 0, id } = Astro.props;
---

<section class="showcase" id={id}>
  <div class="showcase__head">
    <h2 class="showcase__title">{title}</h2>
    {text && <p class="showcase__text">{text}</p>}
  </div>
  <div class:list={["showcase__body", { [`showcase__body--${cols}`]: cols > 0 }]}>
    <slot />
  </div>
</section>

<style>
  .showcase { display: flex; flex-direction: column; gap: 20px; }
  .showcase__head { display: flex; flex-direction: column; gap: 6px; max-width: 68ch; }
  .showcase__title { font-size: 24px; line-height: 32px; font-weight: 700; }
  .showcase__body--2,
  .showcase__body--3,
  .showcase__body--4 { display: grid; gap: 20px; align-items: start; }
  .showcase__body--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .showcase__body--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .showcase__body--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  /* Gambar di dalam galeri: sudut membulat + bayangan, keterangan kecil di bawah */
  .showcase__body :global(figure) { display: flex; flex-direction: column; gap: 8px; }
  .showcase__body :global(.zoom) { overflow: hidden; border-radius: var(--radius); box-shadow: var(--shadow-frame); background: var(--c-white); }
  .showcase__body :global(figcaption) { font-size: 14px; line-height: 20px; color: var(--c-muted); }

  @media (max-width: 767px) {
    .showcase__title { font-size: 20px; line-height: 28px; }
    .showcase__body--3,
    .showcase__body--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .showcase__body--2 { grid-template-columns: 1fr; }
  }
</style>
