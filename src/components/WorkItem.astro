---
import { Image } from "astro:assets";
import WorkflowDiagram from "./WorkflowDiagram.astro";
import type { Work } from "../data/projects";

interface Props {
  work: Work;
  headingLevel?: "h2" | "h3";
}
const { work, headingLevel: Heading = "h3" } = Astro.props;
const Tag = work.href ? "a" : "div";
---

<Tag class="work" href={work.href}>
  <div class="work__media">
    {work.images ? (
      <div class="work__panels">
        {work.images.map((img) => <Image src={img} alt="" widths={[120, 240]} sizes="(max-width: 767px) 33vw, 82px" />)}
      </div>
    ) : work.image ? (
      <Image src={work.image} alt="" widths={[300, 520, 760]} sizes="(max-width: 767px) calc(100vw - 40px), 246px" />
    ) : (
      work.visual === "workflow" && <WorkflowDiagram compact />
    )}
  </div>
  <div class="work__text">
    <p class="work__name">{work.name} <span class="work__tags">{work.tags.join(" · ")}</span></p>
    <Heading class="work__problem">{work.problem}</Heading>
    <p class="work__solution"><b>Solution:</b> {work.solution}</p>
    {work.cta && <span class="work__cta">{work.cta} <span class="work__arrow" aria-hidden="true">→</span></span>}
  </div>
</Tag>

<style>
  .work {
    display: flex;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .work__media {
    flex: none;
    width: 246px;
    height: 180px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-placeholder);
  }
  .work__media:has(> img) { border: 1px solid var(--c-line); }
  .work__panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; height: 100%; }
  .work__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.4s ease;
  }
  .work__media .work__panels :global(img) { object-position: center; }
  .work__text { flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .work__name { font-size: 15px; line-height: 22px; font-weight: 500; color: var(--c-muted); }
  .work__tags { font-weight: 400; }
  .work__tags::before { content: "· "; }
  .work__problem { font-size: 26px; line-height: 34px; font-weight: 700; }
  .work__solution b { font-weight: 700; }
  .work__cta { font-size: 16px; line-height: 24px; font-weight: 700; color: var(--c-link); }
  .work__arrow { display: inline-block; transition: transform 0.2s ease; }

  a.work:hover .work__problem { color: var(--c-primary); }
  @media (prefers-reduced-motion: no-preference) {
    a.work:hover .work__media :global(img) { transform: scale(1.04); }
    a.work:hover .work__arrow { transform: translateX(4px); }
  }

  @media (max-width: 767px) {
    .work { flex-direction: column; gap: 16px; }
    .work__media { width: 100%; height: 210px; }
    .work__name { font-size: 14px; }
    .work__problem { font-size: 22px; line-height: 30px; }
  }
</style>
