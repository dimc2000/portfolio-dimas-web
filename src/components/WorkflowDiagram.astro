---
// Alur Content Workflow Automation. `compact` = versi kecil untuk kartu karya.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

// Sama dengan workflow asli di "2 content-engine-n8n" (Obsidian → Gemini → cek klaim → Telegram → Ready)
const steps = [
  { title: "Pick idea", tool: "Obsidian", text: "Takes the next idea marked as selected." },
  { title: "Draft", tool: "Gemini API", text: "Writes the first version." },
  { title: "Rules check", tool: "n8n", text: "Flags risky claims." },
  { title: "Human approval", tool: "Telegram", text: "Nothing moves on without a sign-off.", gate: true },
  { title: "Ready", tool: "Obsidian", text: "Approved posts are saved, ready to go." },
  { title: "Publish", tool: "Person", text: "Posted by hand after approval." },
];
---

{compact ? (
  <ol class="flow flow--compact" aria-label="Workflow steps">
    {steps.map((s) => <li class:list={{ "is-gate": s.gate }}>{s.title}</li>)}
  </ol>
) : (
  <ol class="flow">
    {steps.map((s, i) => (
      <li class:list={["flow__step", { "is-gate": s.gate }]}>
        <span class="flow__num" aria-hidden="true">{i + 1}</span>
        <p class="flow__title">{s.title}</p>
        <p class="flow__tool">{s.tool}</p>
        <p class="flow__text">{s.text}</p>
      </li>
    ))}
  </ol>
)}

<style>
  /* ---------- Versi lengkap ---------- */
  .flow {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    padding: 32px 28px;
    background: var(--c-soft);
    border-radius: var(--radius);
  }
  .flow__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 14px;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: 4px;
  }
  /* garis penghubung antar langkah */
  .flow__step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 29px;
    right: -13px;
    width: 14px;
    height: 2px;
    background: var(--c-link-bright);
  }
  .flow__num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-bottom: 6px;
    border-radius: 50%;
    background: var(--c-badge);
    color: var(--c-white);
    font-size: 13px;
    font-weight: 700;
  }
  .flow__title { font-size: 16px; line-height: 22px; font-weight: 700; }
  .flow__tool { font-size: 13px; line-height: 18px; color: var(--c-muted); }
  .flow__text { margin-top: 4px; font-size: 14px; line-height: 20px; }

  .flow__step.is-gate { border-color: var(--c-primary); box-shadow: inset 0 0 0 1px var(--c-primary); }
  .flow__step.is-gate .flow__num { background: var(--c-primary); color: var(--c-text); }

  @media (max-width: 900px) {
    .flow { grid-template-columns: 1fr; padding: 20px; gap: 10px; }
    .flow__step { display: grid; grid-template-columns: 26px 1fr; column-gap: 14px; row-gap: 2px; padding: 14px; }
    .flow__num { grid-row: span 3; margin: 0; }
    .flow__text { margin: 0; }
    .flow__step:not(:last-child)::after { top: auto; bottom: -11px; right: auto; left: 27px; width: 2px; height: 10px; }
  }

  /* ---------- Versi kecil (kartu) ---------- */
  .flow--compact {
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 100%;
    height: 100%;
    padding: 14px 22px;
    background: var(--c-soft);
    border-radius: var(--radius);
    font-size: 13px;
    line-height: 18px;
    font-weight: 500;
  }
  .flow--compact li {
    position: relative;
    padding-left: 20px;
  }
  .flow--compact li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-surface);
    box-shadow: inset 0 0 0 2px var(--c-link-bright);
  }
  .flow--compact li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 14px;
    width: 2px;
    height: 12px;
    background: var(--c-link-bright);
    opacity: 0.5;
  }
  .flow--compact li.is-gate::before { background: var(--c-primary); box-shadow: none; }
</style>
