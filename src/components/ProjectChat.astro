---
/*
  "How we'll work": alur proyek sebagai percakapan chat (mirip WhatsApp), bukan daftar bernomor.
  Contoh ilustrasi dari sudut pandang calon klien ("you"), bukan kutipan klien sungguhan.
  Gelembung muncul satu per satu saat bagian ini terlihat di layar (kecuali pengunjung memilih reduced motion).
*/
type Attachment = "file" | "link" | "folder";
type Item =
  | { day: string }
  | { from: "you" | "me"; text: string }
  | { from: "me"; attach: Attachment; title: string; sub: string };

const chat: Item[] = [
  { day: "Start" },
  { from: "you", text: "Hi Dimas, I have a project in mind." },
  { from: "me", text: "Great! Quick call today?" },
  { day: "Plan" },
  { from: "me", attach: "file", title: "Project plan.pdf", sub: "Scope and timeline" },
  { day: "Build" },
  { from: "me", attach: "link", title: "Preview is ready", sub: "Take a look" },
  { from: "you", text: "Looks great! Can we change the color?" },
  { from: "me", text: "Done. Preview updated." },
  { day: "Handover" },
  { from: "me", attach: "folder", title: "Final files", sub: "All yours, plus a how-to video" },
];

const promises = [
  "Plan in writing before work starts",
  "Previews as I go. No surprises.",
  "Nothing goes live without your OK",
  "All files are yours",
];

// Ikon garis 24x24 untuk lampiran
const icons: Record<Attachment, string> = {
  file: "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4",
  link: "M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1",
  folder: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
};
---

<section class="how" aria-labelledby="how-title">
  <div class="how__text">
    <h2 class="section-title" id="how-title">How we'll work</h2>
    <ul class="promises">
      {promises.map((p) => (
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          {p}
        </li>
      ))}
    </ul>
  </div>

  <figure class="chat" aria-label="Example of how a project goes, shown as a chat">
    <div class="chat__head">
      <span class="chat__avatar" aria-hidden="true"><span></span></span>
      <span class="chat__name">Dimas Aji Samudra</span>
    </div>
    <ol class="chat__body">
      {chat.map((item, i) =>
        "day" in item ? (
          <li class="chat__day" style={`--i:${i}`}>{item.day}</li>
        ) : "attach" in item ? (
          <li class="msg msg--me msg--attach" style={`--i:${i}`}>
            <span class="msg__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20"><path d={icons[item.attach]} /></svg>
            </span>
            <span>
              <strong class="msg__title">{item.title}</strong>
              <span class="msg__sub">{item.sub}</span>
            </span>
          </li>
        ) : (
          <li class:list={["msg", `msg--${item.from}`]} style={`--i:${i}`}>
            <span class="visually-hidden">{item.from === "you" ? "You:" : "Dimas:"}</span>
            {item.text}
          </li>
        ),
      )}
    </ol>
  </figure>
</section>

<script>
  // Gelembung muncul berurutan saat chat terlihat. Tanpa JS atau dengan reduced motion: langsung tampil semua.
  const chats = document.querySelectorAll<HTMLElement>(".chat");
  if (chats.length && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-playing");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.35 },
    );
    chats.forEach((chat) => {
      chat.classList.add("is-ready");
      observer.observe(chat);
    });
  }
</script>

<style>
  .how {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: 48px;
    align-items: center;
    padding: 72px 0 16px;
  }
  .how__text { display: flex; flex-direction: column; gap: 24px; }
  .promises { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .promises li { display: flex; gap: 12px; font-size: 19px; line-height: 27px; font-weight: 500; }
  .promises svg { flex: none; margin-top: 3px; color: var(--c-primary); }
  .how svg { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- Chat ---------- */
  .chat {
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: 20px;
    background: var(--c-soft);
    box-shadow: var(--shadow-frame);
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-line);
  }
  .chat__avatar { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--c-text); }
  .chat__avatar span {
    width: 24px;
    aspect-ratio: 320 / 233;
    background-color: var(--c-surface);
    -webkit-mask: url("/brand/logo-mark.png") center / contain no-repeat;
    mask: url("/brand/logo-mark.png") center / contain no-repeat;
  }
  .chat__name { font-size: 15px; line-height: 20px; font-weight: 700; }

  .chat__body { list-style: none; display: flex; flex-direction: column; gap: 8px; padding: 16px 14px 20px; }
  .chat__day {
    align-self: center;
    margin: 6px 0 2px;
    padding: 2px 10px;
    border-radius: 8px;
    background: var(--c-surface);
    font-size: 12px;
    line-height: 18px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .msg {
    max-width: 82%;
    padding: 8px 12px;
    border-radius: 14px;
    font-size: 15px;
    line-height: 21px;
    box-shadow: 0 1px 2px rgba(20, 30, 60, 0.12);
  }
  .msg--me { align-self: flex-start; background: var(--c-surface); border-top-left-radius: 4px; }
  .msg--you {
    align-self: flex-end;
    background: color-mix(in srgb, var(--c-primary) 20%, var(--c-surface));
    border-top-right-radius: 4px;
  }
  .msg--attach { display: flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; }
  .msg__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--c-link-bright) 16%, transparent);
    color: var(--c-link);
  }
  .msg__title { display: block; font-size: 15px; line-height: 20px; font-weight: 700; }
  .msg__sub { display: block; font-size: 13px; line-height: 18px; color: var(--c-muted); }

  /* Tema gelap: latar chat pekat dan gelembung sedikit lebih terang agar batasnya terlihat */
  :global(:root[data-theme="dark"]) .chat { background: #0a101d; }
  :global(:root[data-theme="dark"]) .msg--me,
  :global(:root[data-theme="dark"]) .chat__day { background: #1b2439; }

  /* Animasi: hanya bila JS menandai chat .is-ready (lihat skrip) */
  .chat.is-ready .chat__body > li { opacity: 0; translate: 0 10px; }
  .chat.is-playing .chat__body > li {
    animation: bubble-in 0.35s ease-out forwards;
    animation-delay: calc(var(--i) * 0.32s);
  }
  @keyframes bubble-in { to { opacity: 1; translate: 0 0; } }

  @media (max-width: 899px) {
    .how { grid-template-columns: 1fr; gap: 32px; }
    .chat { width: min(100%, 420px); }
  }
  @media (max-width: 767px) {
    .how { padding-top: 48px; }
    .promises li { font-size: 17px; line-height: 24px; }
  }
</style>
