---
/*
  Deretan video vertikal (9:16) seperti feed TikTok, atau video landscape (16:9).
  Video baru diunduh saat diputar (preload="none"); satu video diputar, yang lain berhenti.
  Portrait — desktop: grid, mobile: geser ke samping. Landscape — selalu grid.
*/
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

export interface ReelVideo {
  src: string;
  poster: ImageMetadata;
  title: string;
  caption?: string;
}

interface Props {
  videos: ReelVideo[];
  label: string;
  orientation?: "portrait" | "landscape";
}

const { videos, label, orientation = "portrait" } = Astro.props;
const posterWidth = orientation === "landscape" ? 1280 : 540;
const items = await Promise.all(
  videos.map(async (v) => ({
    ...v,
    posterSrc: (await getImage({ src: v.poster, width: Math.min(posterWidth, v.poster.width), format: "webp" })).src,
  })),
);
---

<ul class:list={["reel", `reel--${orientation}`]} aria-label={label} style={`--count:${videos.length}`}>
  {items.map((v) => (
    <li class="reel__item">
      <div class="reel__frame">
        <video
          class="reel__video"
          src={v.src}
          poster={v.posterSrc}
          preload="none"
          playsinline
          aria-label={v.title}
        ></video>
        <button class="reel__play" type="button" aria-label={`Play: ${v.title}`}>
          <svg viewBox="0 0 48 48" width="56" height="56" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="rgba(33,36,61,.72)" /><path d="M19 15v18l15-9z" fill="#fff" /></svg>
        </button>
      </div>
      <p class="reel__title">{v.title}</p>
      {v.caption && <p class="reel__caption">{v.caption}</p>}
    </li>
  ))}
</ul>

<script>
  document.querySelectorAll<HTMLElement>(".reel").forEach((reel) => {
    const videos = [...reel.querySelectorAll<HTMLVideoElement>(".reel__video")];
    reel.querySelectorAll<HTMLButtonElement>(".reel__play").forEach((btn, i) => {
      btn.addEventListener("click", () => {
        videos[i].controls = true; // kontrol bawaan baru muncul setelah diputar, poster tetap bersih
        videos[i].play();
      });
    });
    videos.forEach((video) => {
      video.addEventListener("play", () => {
        // Setelah diputar sekali, tombol overlay hilang agar kontrol bawaan (seek, volume) bisa dipakai
        video.closest(".reel__item")?.classList.add("has-started");
        // Hanya satu video di seluruh halaman yang berbunyi
        document.querySelectorAll<HTMLVideoElement>(".reel__video").forEach((other) => {
          if (other !== video) other.pause();
        });
      });
    });
  });
</script>

<style>
  .reel {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    gap: 16px;
  }
  .reel__item { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .reel__frame {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 14px;
    background: var(--c-text);
    box-shadow: var(--shadow-frame);
  }
  .reel__video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .reel__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .reel__play svg { transition: scale 0.15s ease; }
  .reel__play:hover svg { scale: 1.08; }
  .has-started .reel__play { display: none; }
  .reel__title { margin-top: 6px; font-size: 16px; line-height: 22px; font-weight: 700; }
  .reel__caption { font-size: 14px; line-height: 20px; color: var(--c-muted); }

  .reel--landscape .reel__frame { aspect-ratio: 16 / 9; border-radius: 10px; }
  .reel--landscape .reel__video { object-fit: contain; }

  @media (max-width: 900px) {
    .reel--portrait {
      display: flex;
      gap: 12px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
    }
    .reel--portrait .reel__item { flex: 0 0 min(62vw, 240px); scroll-snap-align: start; }
    .reel--landscape { grid-template-columns: 1fr; }
  }
</style>
